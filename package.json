{
  "name": "gdg-on-campus-hackathon-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build:archive": "./scripts/build-archive.sh",
